<?xml version="1.0" encoding="UTF-8" ?>
<class name="EncounterScript" inherits="Node" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
    <brief_description>
        [color=red](사용자 생성 불가능)[/color]
        전투를 제어 할수 있는 사용자 정의 스크립트 노드입니다.
    </brief_description>
    <description>
        이 노드는 전투 중에 발생하는 다양한 이벤트를 제어하는 데 사용됩니다. 
        예를 들어, 배경, 공격 매니저, 카메라 컨트롤러 등을 제어할 수 있습니다.
        또한, 플레이어의 턴 여부를 확인할 수 있는 기능도 제공합니다.
    </description>
    <tutorials></tutorials>

    <methods>
        <method name="ready" qualifiers="virtual">
            <return type="void"/>
            <description>
                초기화 작업을 수행합니다. _ready() 메서드 대신 사용됩니다.
            </description>
        </method>
    </methods>

    <members>
        <member name="main" type="BattleMain" setter="set_property" getter="get_main">
            전투 메인 노드에 대한 참조입니다.
        </member>

        <member name="box" type="BattleBox" setter="set_property" getter="get_box">
            전투 박스 노드에 대한 참조입니다.
        </member>

        <member name="hub" type="BattleHUD" setter="set_property" getter="get_hub">
            전투 HUD 노드에 대한 참조입니다.
        </member>

        <member name="bg" type="TextureRect" setter="set_property" getter="get_bg">
            전투 배경을 나타내는 TextureRect 노드에 대한 참조입니다.
        </member>

        <member name="attacks" type="AttackManager" setter="set_property" getter="get_attacks">
            공격 매니저 노드에 대한 참조입니다.
        </member>

        <member name="camera" type="CameraController" setter="set_property" getter="get_camera">
            카메라 컨트롤러 노드에 대한 참조입니다.
        </member>

        <member name="player_turn" type="bool" setter="set_property" getter="get_player_turn">
            플레이어의 턴인지 여부를 나타내는 불리언 값입니다.
        </member>

        <member name="soul" type="SoulBattle" setter="set_property" getter="get_soul">
            전투 중인 소울 노드에 대한 참조입니다.
        </member>
    </members>
</class>