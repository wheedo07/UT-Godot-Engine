[configuration]

entry_symbol = "undertale_plugin_main_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_32 = "res://bin/lib/lib.UndertalePlugin.windows_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/lib/lib.UndertalePlugin.windows_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/lib/lib.UndertalePlugin.windows_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/lib/lib.UndertalePlugin.windows_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/lib/lib.UndertalePlugin.linux_debug.x86_64.so"
linux.release.x86_64 = "res://bin/lib/lib.UndertalePlugin.linux_release.x86_64.so"
linux.debug.x86_32 = "res://bin/lib/lib.UndertalePlugin.linux_debug.x86_32.so"
linux.release.x86_32 = "res://bin/lib/lib.UndertalePlugin.linux_release.x86_32.so"
linux.debug.arm64 = "res://bin/lib/lib.UndertalePlugin.linux_debug.arm64.so"
linux.release.arm64 = "res://bin/lib/lib.UndertalePlugin.linux_release.arm64.so"
linux.debug.rv64 = "res://bin/lib/lib.UndertalePlugin.linux_debug.rv64.so"
linux.release.rv64 = "res://bin/lib/lib.UndertalePlugin.linux_release.rv64.so"
android.debug.x86_64 = "res://bin/lib/lib.UndertalePlugin.android_debug.x86_64.so"
android.release.x86_64 = "res://bin/lib/lib.UndertalePlugin.android_release.x86_64.so"
android.debug.arm64 = "res://bin/lib/lib.UndertalePlugin.android_debug.arm64.so"
android.release.arm64 = "res://bin/lib/lib.UndertalePlugin.android_release.arm64.so"
web.debug.wasm32 = "res://bin/lib/lib.UndertalePlugin.web_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/lib/lib.UndertalePlugin.web_release.wasm32.wasm"
web.debug.wasm32.nothreads = "res://bin/lib/lib.UndertalePlugin.web_debug.wasm32.nothreads.wasm"
web.release.wasm32.nothreads = "res://bin/lib/lib.UndertalePlugin.web_release.wasm32.nothreads.wasm"

