[configuration]

entry_symbol = "undertale_plugin_main_init"
compatibility_minimum = "4.5"

[libraries]

windows.editor.x86_32 = "res://bin/lib/lib.UndertalePlugin.windows.editor.x86_32.dll"
windows.editor.x86_64 = "res://bin/lib/lib.UndertalePlugin.windows.editor.x86_64.dll"
linux.editor.x86_64 = "res://bin/lib/lib.UndertalePlugin.linux.editor.x86_64.so"
linux.editor.x86_32 = "res://bin/lib/lib.UndertalePlugin.linux.editor.x86_32.so"
linux.editor.arm64 = "res://bin/lib/lib.UndertalePlugin.linux.editor.arm64.so"
linux.editor.rv64 = "res://bin/lib/lib.UndertalePlugin.linux.editor.rv64.so"
android.editor.x86_64 = "res://bin/lib/lib.UndertalePlugin.android.editor.x86_64.so"
android.editor.arm64 = "res://bin/lib/lib.UndertalePlugin.android.editor.arm64.so"
web.editor.wasm32 = "res://bin/lib/lib.UndertalePlugin.web.editor.wasm32.wasm"
web.editor.wasm32.nothreads = "res://bin/lib/lib.UndertalePlugin.web.editor.wasm32.nothreads.wasm"

[icons]
