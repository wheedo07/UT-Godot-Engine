[configuration]

entry_symbol = "undertale_engine_main_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_32 = "res://bin/lib/lib.UndertaleEngine.windows_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/lib/lib.UndertaleEngine.windows_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/lib/lib.UndertaleEngine.windows_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/lib/lib.UndertaleEngine.windows_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/lib/lib.UndertaleEngine.linux_debug.x86_64.so"
linux.release.x86_64 = "res://bin/lib/lib.UndertaleEngine.linux_release.x86_64.so"
linux.debug.x86_32 = "res://bin/lib/lib.UndertaleEngine.linux_debug.x86_32.so"
linux.release.x86_32 = "res://bin/lib/lib.UndertaleEngine.linux_release.x86_32.so"
linux.debug.arm64 = "res://bin/lib/lib.UndertaleEngine.linux_debug.arm64.so"
linux.release.arm64 = "res://bin/lib/lib.UndertaleEngine.linux_release.arm64.so"
linux.debug.rv64 = "res://bin/lib/lib.UndertaleEngine.linux_debug.rv64.so"
linux.release.rv64 = "res://bin/lib/lib.UndertaleEngine.linux_release.rv64.so"
android.debug.x86_64 = "res://bin/lib/lib.UndertaleEngine.android_debug.x86_64.so"
android.release.x86_64 = "res://bin/lib/lib.UndertaleEngine.android_release.x86_64.so"
android.debug.arm64 = "res://bin/lib/lib.UndertaleEngine.android_debug.arm64.so"
android.release.arm64 = "res://bin/lib/lib.UndertaleEngine.android_release.arm64.so"
web.debug.wasm32 = "res://bin/lib/lib.UndertaleEngine.web_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/lib/lib.UndertaleEngine.web_release.wasm32.wasm"
web.debug.wasm32.nothreads = "res://bin/lib/lib.UndertaleEngine.web_debug.wasm32.nothreads.wasm"
web.release.wasm32.nothreads = "res://bin/lib/lib.UndertaleEngine.web_release.wasm32.nothreads.wasm"

[icons]

Overworld = "res://Engine/icon/overworld.png"
ShopCreate = "res://Engine/icon/shop_create.png"
RoomEntranceNode = "res://Engine/icon/room_entrance_node.png"
GenericTextTyper = "res://Engine/icon/text_typer.png"
AdvancedTextTyper = "res://Engine/icon/text_typer.png"
Bullet = "res://Engine/icon/bullet.png"
DefaultBullet = "res://Engine/icon/defaultbullet.png"
BulletArea = "res://Engine/icon/bullet_area.png"
Enemy = "res://Engine/icon/enemy.png"
AttackBase = "res://Engine/icon/attacks.png"
BattleObject = "res://Engine/icon/battle_object.png"
OptionSelectableSolo = "res://Engine/icon/option_selectable_solo.png"
CameraController = "res://Engine/icon/camera_controller.png"
CharacterSetting = "res://Engine/icon/character_setting.png"
OverworldCharacterNode = "res://Engine/icon/overworld_character.png"
OverworldSprite = "res://Engine/icon/overworld_sprite.png"
AttackAnimation = "res://Engine/icon/attack_animation.png"
AttackMeter = "res://Engine/icon/attack_meter.png"