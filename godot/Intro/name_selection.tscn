[sub_resource type="GDScript" id="GDScript_8npst"]
resource_name = "NameSelection_gd"
script/source = "extends NameSelection

func check_names(player_name: String) -> void:
	if(player_name == \"SANS\"):
		react_to_name(\"NO!!!\", true);
	elif(player_name == \"GASTER\"):
		global.alert(\"NO\", \"ERROR\");
	else:
		react_to_name(\"LO_NAME_CHECK\");
"

